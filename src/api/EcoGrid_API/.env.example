# Servidor FastAPI
HOST=127.0.0.1
PORT=8000
DATA_DIR=data/raw

# Oracle Autonomous Database
# Mantén false hasta disponer de wallet y credenciales locales fuera del repositorio.
ORACLE_ENABLED=false
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=
ORACLE_WALLET_DIR=
ORACLE_WALLET_PASSWORD=
ORACLE_CONNECT_TIMEOUT=20

# Calendario y comunidades
CALENDAR_TZ=Europe/Madrid
NACIONAL_CCAA_CODINE=00
METEO_CCAA_CODINE=13
REE_DEMAND_MIN_MW=15000
REE_DEMAND_MAX_MW=45000
OMIE_PRICE_MIN_EUR=-500
OMIE_PRICE_MAX_EUR=4000

# API externa REE/ESIOS (opcional)
ESIOS_API_TOKEN=

# Integración con Spring Boot
SPRING_API_BASE_URL=http://127.0.0.1:8080
SPRING_PREDICTIONS_API_KEY=
PREDICTION_MODEL_ID=1
PREDICTION_MODEL_PATH=models/modelo_xgboost_demanda.json